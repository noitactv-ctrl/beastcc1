# Required application settings
POSTGRES_DB=nychq
POSTGRES_USER=nychq
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql://nychq:change-this-password@localhost:5432/nychq
SESSION_SECRET=replace-with-a-long-random-secret
SETTINGS_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
ADMIN_EMAILS=you@example.com
OWNER_EMAILS=you@example.com
PORT=5000

# Optional Plisio crypto checkout settings.
# Crypto also requires a public HTTPS URL and enabled currencies in the admin panel.
PLISIO_PUBLIC_APP_URL=https://your-domain.example
PLISIO_API_KEY=
PLISIO_API_BASE_URL=https://api.plisio.net/api/v1